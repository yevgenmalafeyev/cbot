# Copy to /opt/cbot/.env on the server (chmod 600). Never commit real values.
TELEGRAM_BOT_TOKEN=            # main bot token from @BotFather
OWNER_TG_ID=                   # the only Telegram user the bots answer to
PUBLIC_URL=https://bot.example.com   # the public HTTPS address of this instance (see deploy/nginx)
MASTER_KEY=                    # 32 random bytes, hex: openssl rand -hex 32 (encrypts the secret store)
BOXD_TOKEN=                    # shared between core and box: openssl rand -hex 32
GROQ_API_KEY=                  # optional: voice message transcription
GOOGLE_CLIENT_ID=               # optional: Google OAuth client (web application) for connecting Gmail
GOOGLE_CLIENT_SECRET=
TZ=Europe/Lisbon
# Optional tuning (defaults shown)
# MEMORY_CHAR_LIMIT=8000       # a bot's CLAUDE.md is consolidated past this size
# MEMORY_REVIEW=1              # 0: no review pass after tasks
# MEMORY_REVIEW_MODEL=haiku    # model of the review pass
# UNATTENDED_ANSWER_HOURS=12   # scheduled and mail-watch runs stop waiting for the owner after this
# PARK_AFTER_SECONDS=60        # a task waiting on the owner this long gives up its slot when others queue
# SPILL_CHARS=2500             # longer task results are kept in full as a file

# The box gets its own file, /opt/cbot/box.env, with exactly one line:
#   BOXD_TOKEN=<the same value as above>
# The box must never see this file.
