#!/bin/bash
# Render an SVG to a 640x640 JPEG (Telegram profile photo).
#   cbot-render-icon <in.svg> <out.jpg>
set -e
d=$(mktemp -d); trap 'rm -rf "$d"' EXIT
timeout 30 rsvg-convert --width 640 --height 640 --background-color white "$1" -o "$d/icon.png"
convert "$d/icon.png" -resize '640x640^' -gravity center -extent 640x640 -quality 92 "$2"
